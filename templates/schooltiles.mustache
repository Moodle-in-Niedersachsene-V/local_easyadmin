{{!
    @template local_easyadmin/schooltiles

    Zeigt die konfigurierten Schul-Kacheln auf der Startseite an.
    Nutzt durchgehend doppelte Mustache-Klammern (automatisches
    HTML-Escaping) statt ungefilterter Ausgabe.

    Context variables required for this template:
    * tiles - Liste der anzuzeigenden Kacheln (name, icon, imageurl, color, textcolor, url)
    * canmanage - bool, ob ein Bearbeiten-Link angezeigt werden soll
    * manageurl - Adresse der Verwaltungsseite
    * sizeclass - CSS-Klasse für die Kachelgröße
    * alignclass - CSS-Klasse für die Ausrichtung

    Example context (json):
    {
        "canmanage": true,
        "manageurl": "https://example.org/local/easyadmin/schooltiles.php",
        "sizeclass": "local-easyadmin-size-medium",
        "alignclass": "local-easyadmin-align-center",
        "tiles": [
            {
                "name": "Bibliothek",
                "icon": "📚",
                "imageurl": null,
                "color": "#4A90E2",
                "textcolor": "#FFFFFF",
                "url": "https://example.org/course/index.php?categoryid=1"
            }
        ]
    }
}}
<div class="local-easyadmin-schooltiles">
    {{#canmanage}}
        <div class="local-easyadmin-schooltiles-managelink">
            <a href="{{manageurl}}">{{#str}}schooltile_managelink, local_easyadmin{{/str}}</a>
        </div>
    {{/canmanage}}
    <div class="local-easyadmin-schooltiles-grid {{sizeclass}} {{alignclass}}">
        {{#tiles}}
            <a class="local-easyadmin-schooltile" href="{{url}}"
               style="background-color:{{color}};color:{{textcolor}};">
                {{#imageurl}}
                    <img src="{{imageurl}}" alt="" class="local-easyadmin-schooltile-image">
                {{/imageurl}}
                {{^imageurl}}
                    <span class="local-easyadmin-schooltile-icon" aria-hidden="true">{{icon}}</span>
                {{/imageurl}}
                <span class="local-easyadmin-schooltile-name">{{name}}</span>
            </a>
        {{/tiles}}
    </div>
</div>
