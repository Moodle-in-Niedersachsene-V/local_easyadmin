{{!
    @template local_easyadmin/dashboard

    Zeigt entweder die Kachel-Übersicht oder einen Platzhalter für einen
    noch nicht implementierten Teilbereich.

    Context variables required for this template:
    * showplaceholder - bool
    * welcometitle, welcomeintro - string (Übersicht)
    * tiles - array (Übersicht)
    * hastiles - bool
    * nopermissiontext - string
    * sectiontitle, placeholdertext, backurl, backlabel - string (Platzhalter)
}}
<div class="local-easyadmin-dashboard">

{{#showplaceholder}}
    <div class="ea-placeholder card p-4 mb-3">
        <h3>{{sectiontitle}}</h3>
        <p class="text-muted">{{placeholdertext}}</p>
        <a href="{{backurl}}" class="btn btn-secondary">
            &larr; {{backlabel}}
        </a>
    </div>
{{/showplaceholder}}

{{^showplaceholder}}
    <div class="ea-welcome mb-4">
        <h2>{{welcometitle}}</h2>
        <p class="lead">{{welcomeintro}}</p>
    </div>

    {{#hastiles}}
        <div class="ea-tile-grid">
            {{#tiles}}
                <a href="{{url}}" class="ea-tile {{colorclass}}">
                    <span class="ea-tile-icon" aria-hidden="true">{{emoji}}</span>
                    <span class="ea-tile-title">{{title}}</span>
                    <span class="ea-tile-desc">{{description}}</span>
                </a>
            {{/tiles}}
        </div>
    {{/hastiles}}

    {{^hastiles}}
        <div class="alert alert-info">{{nopermissiontext}}</div>
    {{/hastiles}}
{{/showplaceholder}}

</div>

{{#js}}
require(['jquery'], function() {
    // Platz für zukünftige Interaktionen (z. B. Live-Vorschau bei Design-Änderungen).
});
{{/js}}
